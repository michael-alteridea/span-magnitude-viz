{
  "name": "span-magnitude-viz",
  "version": "1.0.0",
  "description": "Temporal magnitude storytelling: span × magnitude marks with animated reveal and cumulative tickers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema/v1.json": "./schema/v1.json"
  },
  "files": [
    "dist",
    "schema",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external d3,zod",
    "prepare": "npm run build",
    "dev": "vite --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build:standalone": "node scripts/build-standalone-offline.mjs",
    "build:geo": "node scripts/build-europe-geo.mjs",
    "build:maps": "node scripts/build-map-svgs.mjs && python3 scripts/render-map-previews.py",
    "dev:studio": "vite --config studio/vite.config.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "preview:studio": "vite preview --config studio/vite.config.ts",
    "build:studio:offline": "node studio/scripts/build-offline.mjs",
    "test": "vitest run",
    "test:e2e:studio": "node studio/scripts/e2e.mjs"
  },
  "keywords": [
    "visualization",
    "d3",
    "svg",
    "temporal",
    "span",
    "magnitude",
    "storytelling"
  ],
  "license": "MIT",
  "dependencies": {
    "d3": "^7.9.0",
    "qrcode-generator": "^2.0.4",
    "topojson-client": "^3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "jsqr": "^1.4.0",
    "linkedom": "^0.18.13",
    "mapshaper": "^0.7.80",
    "pptxgenjs": "^4.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "sideEffects": false
}
