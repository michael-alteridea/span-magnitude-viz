{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "isolatedModules": true,
    "paths": {
      "span-magnitude-viz": [
        "./src/index.ts"
      ],
      "span-magnitude-viz/*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "demo/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "demo/vite.config.ts",
    "demo-dist"
  ]
}
